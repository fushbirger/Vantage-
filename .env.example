# ── Vantage ────────────────────────────────────────────────────────────────
# Demo sign-in sessions use this secret. Change it for anything beyond local dev.
VANTAGE_SESSION_SECRET=change-me-to-a-long-random-string

# SQLite location (defaults to ./data/vantage.db)
# VANTAGE_DB_PATH=/absolute/path/to/vantage.db

# Public base URL used in WhatsApp deep links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Business Cloud API (optional — without these, messages are simulated)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=vantage-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
